    def fetch(self, limit=5):
        return [{"name": "Sua tam trang da (mock)", "price": 89000, "commission": 7, "url": "#", "strategy": "M1"}]

class AlibabaAgent(BaseAgent):
    platform = "alibaba"
    def fetch(self, limit=5):
        return [{"name": "Loa bluetooth (mock)", "price": 250000, "commission": 18, "url": "#", "strategy": "M2"}]

def run_all_agents():
    agents = [ShopeeAgent(), LazadaAgent(), TikTokAgent(), FacebookAgent(), ZaloAgent(), AlibabaAgent()]
    all_products = []
    for agent in agents:
        products = agent.fetch()
        if products:
            for p in products:
                p['platform'] = agent.platform
            all_products.extend(products)
            print(f"[OK] {agent.platform}: {len(products)} san pham")
        else:
            print(f"[WARN] {agent.platform}: khong co san pham")
    save_products(all_products)
    print(f"[INFO] Tong {len(all_products)} san pham da luu vao database")
    return all_products