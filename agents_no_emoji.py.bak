import os
import requests
import json
import re
from database import save_products
from dotenv import load_dotenv

load_dotenv()

class BaseAgent:
    platform = "unknown"
    def fetch(self):
        return []

class ShopeeAgent(BaseAgent):
    platform = "shopee"
    def fetch(self, limit=5):
        # Mock data
        return [{"name": "Ao thun nam (mock)", "price": 129000, "commission": 8, "url": "#", "strategy": "M1"}]

