    platform = "tiktok"
    def fetch(self, limit=5):
        return [{"name": "Mat na duong da (mock)", "price": 299000, "commission": 10, "url": "#", "strategy": "M2"}]

class FacebookAgent(BaseAgent):
    platform = "facebook"
    def fetch(self, limit=5):
        return [{"name": "Khoa hoc affiliate (mock)", "price": 499000, "commission": 25, "url": "#", "strategy": "M3"}]

class ZaloAgent(BaseAgent):
