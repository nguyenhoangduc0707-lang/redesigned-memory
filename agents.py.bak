import os
import json
import time
from apify_client import ApifyClient
from database import save_products
from dotenv import load_dotenv

load_dotenv()

class BaseAgent:
    platform = "unknown"
    def fetch(self):
        return []

class TikTokAgent(BaseAgent):
    platform = "tiktok"

    def fetch(self, limit=5):
        token = os.getenv("APIFY_API_TOKEN")
        if not token:
            print("[TikTokAgent] Khong co token, dung mock.")
            return self._mock_data(limit)

        client = ApifyClient(token)
        # Su dung actor trending-products-scraper (pho bien)
        actor_id = "salmanrajz/trending-products-scraper"
        run_input = {
            "limit": limit,
            "days": 1,
            "region": "uk"
        }
        try:
            print("[TikTokAgent] Dang chay actor...")
            run = client.actor(actor_id).call(run_input=run_input)
            if not run:
                print("[TikTokAgent] Actor run that bai.")
                return self._mock_data(limit)

            items = client.dataset(run["defaultDatasetId"]).list_items().items
            products = []
            for item in items[:limit]:
                name = item.get("name", "No name")
                price_str = item.get("price_display", "0")
                price = self._parse_price(price_str)
                url = item.get("product_url", "")
                # Chuyen doi gia USD sang VND neu co
                if price < 1000:  # neu la USD
                    price = int(price * 25000)
                products.append({
                    "name": name[:100],
                    "price": price,
                    "commission": 10.0,
                    "url": url,
                    "strategy": "M2",
                    "platform": self.platform,
                })
            print(f"[TikTokAgent] Lay duoc {len(products)} san pham thuc.")
            return products
        except Exception as e:
            print(f"[TikTokAgent] Loi: {e}")
            return self._mock_data(limit)

    def _parse_price(self, price_str):
        import re
        if not price_str:
            return 0
        price_float = float(re.sub(r'[^\d.]', '', price_str))
        return int(price_float)

    def _mock_data(self, limit=3):
        return [{"name": f"Mock TikTok {i+1}", "price": 200000, "commission": 10, "url": "#", "strategy": "M2", "platform": self.platform} for i in range(limit)]

class ShopeeAgent(BaseAgent):
    platform = "shopee"
    def fetch(self):
        return [{"name": "Shopee Mock", "price": 150000, "commission": 5, "url": "#", "strategy": "M1", "platform": self.platform}]

class LazadaAgent(BaseAgent):
    platform = "lazada"
    def fetch(self):
        return [{"name": "Lazada Mock", "price": 180000, "commission": 6, "url": "#", "strategy": "M2", "platform": self.platform}]

class FacebookAgent(BaseAgent):
    platform = "facebook"
    def fetch(self):
        return [{"name": "FB Mock", "price": 500000, "commission": 15, "url": "#", "strategy": "M3", "platform": self.platform}]

class ZaloAgent(BaseAgent):
    platform = "zalo"
    def fetch(self):
        return [{"name": "Zalo Mock", "price": 90000, "commission": 8, "url": "#", "strategy": "M1", "platform": self.platform}]

class AlibabaAgent(BaseAgent):
    platform = "alibaba"
    def fetch(self):
        return [{"name": "Alibaba Mock", "price": 300000, "commission": 12, "url": "#", "strategy": "M2", "platform": self.platform}]

def run_all_agents():
    agents = [TikTokAgent(), ShopeeAgent(), LazadaAgent(), FacebookAgent(), ZaloAgent(), AlibabaAgent()]
    all_products = []
    for agent in agents:
        products = agent.fetch()
        if products:
            all_products.extend(products)
            print(f"OK {agent.platform}: {len(products)} san pham")
        else:
            print(f"WARN {agent.platform}: khong co san pham")
    save_products(all_products)
    print(f"Tong {len(all_products)} san pham da luu")
    return all_products
